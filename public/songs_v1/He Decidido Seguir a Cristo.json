{
    "id": "68ff5d82-7808-41ba-8010-0aaa49d51d70",
    "code": "24",
    "title": "HE DECIDIDO SEGUIR A CRISTO",
    "musicalNote": "C|Do",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3883c6e8-cc1a-d3cb-22b3-b3d03125a637",
            "paragraph": "\n// He decidido seguir a Cristo. //\n/ No vuelvo atrás; no vuelvo atrás. /",
            "chorusPos": [
                [
                    0
                ]
            ]
        },
        {
            "id": "17529ab3-ef32-bf8e-20c2-3a5d2e93cfda",
            "paragraph": "// El Rey de gloria me ha transformado. //\n/ No vuelvo atrás; no vuelvo atrás. /",
            "chorusPos": [
                [
                    0
                ]
            ]
        },
        {
            "id": "4cc7a4c6-471f-531f-8828-14c821295c11",
            "paragraph": "// En mis tristezas me da consuelo. //\n/ No vuelvo atrás; no vuelvo atrás. /",
            "chorusPos": [
                [
                    0
                ]
            ]
        },
        {
            "id": "74ef6925-609a-5ca9-141d-5ab3897150c0",
            "paragraph": "// La cruz delante, el mundo atrás. //\n/ No vuelvo atrás; no vuelvo atrás. /",
            "chorusPos": [
                [
                    0
                ]
            ]
        }
    ]
