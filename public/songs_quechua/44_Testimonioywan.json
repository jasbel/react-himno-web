{
    "id": "44",
    "code": "44",
    "title": " 44 Testimonioywan",
    "musicalNote": " (Mi Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "410",
            "chorusPos": [],
            "paragraph": " /Testimonioywan, Dios, chimpaykamuyki/ \n Yachaspa cruzpi Qan wañusqaykita./"
        },
        {
            "id": "411",
            "chorusPos": [],
            "paragraph": " /Testimonioywan, Dios, qayllaykamuyki,/ /Creespa Qanlla salvawasqaykita/"
        },
        {
            "id": "412",
            "chorusPos": [],
            "paragraph": " /Testimonioywan, Dios, Qanman jamuyki/ \n /Churiykimin juchaykuta mayllarqa./"
        },
        {
            "id": "413",
            "chorusPos": [],
            "paragraph": " /Testimonioywan, Dios, chimpaykamuyki/ \n /Qanllamin Supaymanta jark'awankiy"
        },
        {
            "id": "414",
            "chorusPos": [],
            "paragraph": " /Oh Señor, de Ti yo testificaré./ \n /En tu amor me lavaste de mi maldad./"
        },
        {
            "id": "415",
            "chorusPos": [],
            "paragraph": " /Con mi testimonio me allegaré a Ti./ \n /En la eterna salud vivo confiado./"
        },
        {
            "id": "416",
            "chorusPos": [],
            "paragraph": " /Con mi testimonio te confieso hoy./ \n /Porque Tú ¡oh Señor! siempre me cuidas./"
        }
    ]
}