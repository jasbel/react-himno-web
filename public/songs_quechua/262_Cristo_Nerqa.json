    "paragraphs": [
        {
            "id": "2793",
            "chorusPos": [],
            "paragraph": " Cristo nerqa: &quot;Jamuwaychej,/jamuwaychej&quot;/ \n Cristo nerqa:  &ldquo; Jamuwaychej,//samarinkichej &rdquo;//"
        },
        {
            "id": "2794",
            "chorusPos": [],
            "paragraph": " Challwirita ruwasqayki, /ruwasqayki/ \n Challwirita ruwasqayki, //qhatiwajtiyki//"
        },
        {
            "id": "2795",
            "chorusPos": [],
            "paragraph": " Kusiytapis qo¿qaykichej, /qosqaykichej/ Kusiytapis qosqaykichej, //jamojtiykichej.//"
        },
        {
            "id": "2796",
            "chorusPos": [],
            "paragraph": " Cristo dijo: &quot;Venid a Mí, /venid a Mí&quot;./ \n Cristo dijo: &quot;Venid a Mí //y descansaréis&quot;.//"
        },
        {
            "id": "2797",
            "chorusPos": [],
            "paragraph": " Pescadores yo os haré, /yo os haré./ \n Pescadores yo os haré, //si me seguiréis.//"
        },
        {
            "id": "2798",
            "chorusPos": [],
            "paragraph": " Paz, perdón y gozo tendréis, /gozo tendréis/ \n Paz, perdón y gozo tendréis, //si acudís a Mi.//"
        }
    ]
}