    "title": " 291  Jesucristo Kawsan",
    "musicalNote": " (La Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2914",
            "chorusPos": [],
            "paragraph": " //Jesucristo kawsan noqapi.//\nGloria kachun Diosllaman."
        },
        {
            "id": "2915",
            "chorusPos": [],
            "paragraph": " //Jesucristo kawsan qampipis.//\nGloria kachun Diosllaman."
        },
        {
            "id": "2916",
            "chorusPos": [],
            "paragraph": " //Jesucristo Iglesiapi kawsan// \n Gloria kachun Diosllaman."
        },
        {
            "id": "2917",
            "chorusPos": [],
            "paragraph": " //Jesucristo ya reina en mí.//\nAleluya, gloria a Dios."
        },
        {
            "id": "2918",
            "chorusPos": [],
            "paragraph": " //Jesucristo ya reina en ti.//\nAleluya, gloria a Dios."
        },
        {
            "id": "2919",
            "chorusPos": [],
            "paragraph": " //En la Iglesia reina también.// \n Aleluya, gloria a Dios."
        }
    ]
}