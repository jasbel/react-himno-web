{
    "id": "474",
    "code": "474",
    "title": " 474   Cristo Sumaj Michejniy",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "4475",
            "chorusPos": [],
            "paragraph": " /Jesucristo sumaj Michejniy\nCheqan ñampi purichiwan/"
        },
        {
            "id": "4476",
            "chorusPos": [],
            "paragraph": " /Tukuy juchata saqeniña,\nK'anchaynimpitaj purini./"
        },
        {
            "id": "4477",
            "chorusPos": [],
            "paragraph": " /Kay pachapi k'anchawampun:\nCristo Jesús qhuyawajniy/"
        },
        {
            "id": "4478",
            "chorusPos": [],
            "paragraph": " /Juchapi chinkasqa kawsaqe,\nCristoman jamullawajña./"
        },
        {
            "id": "4479",
            "chorusPos": [],
            "paragraph": " /Jesucristoman qayllajtiyki,\nJuchaykita pampachanqa./"
        },
        {
            "id": "4480",
            "chorusPos": [],
            "paragraph": " /Jesucristo es mi Buen Pastor,\nEn su senda Él me guía./"
        },
        {
            "id": "4481",
            "chorusPos": [],
            "paragraph": " /Ya he dejado toda la maldad\nY ando en la luz de Cristo./"
        },
        {
            "id": "4482",
            "chorusPos": [],
            "paragraph": " /En mi vida, Él me alumbrará,\nMi bendito Jesucristo./"
        },
        {
            "id": "4483",
            "chorusPos": [],
            "paragraph": " /¡Oh! amigo cuan perdido estás,\nVen hoy mismo a Jesucristo./"
        },
        {
            "id": "4484",
            "chorusPos": [],
            "paragraph": " /Si tú acudes al Señor Jesús,\nQuitará Él tus pecados./"
        }
    ]
}