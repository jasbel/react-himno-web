{
    "id": "135",
    "code": "135",
    "title": " Munakoj Jesucristo 135",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "1475",
            "chorusPos": [],
            "paragraph": " /Munakoj Jesucristo wajyashawanchej/           /Kunan chimpaykunachej ancha kusiywan./"
        },
        {
            "id": "1476",
            "chorusPos": [],
            "paragraph": " /Salvacionta tarinki Jesucristopi./               /Salvasqaña kaspataj, kusisqa kanki  /"
        },
        {
            "id": "1477",
            "chorusPos": [],
            "paragraph": " /Jesucristota suyay ama puñuspa./                /Kutimuspataj, Payqa pusarisonqa./"
        },
        {
            "id": "1478",
            "chorusPos": [],
            "paragraph": " /Janaj pachapi, Diospa qori llajtampi/                     /Wiñay wiñaypajtaj kawsakamusunchej./"
        },
        {
            "id": "1479",
            "chorusPos": [],
            "paragraph": " /Bendito Jesucristo ofrece salvación./                         /Nos invita a todos, acudamos hoy./"
        },
        {
            "id": "1480",
            "chorusPos": [],
            "paragraph": " /Sólo en Jesucristo hay plena salvación./                     /Debes obtenerla, gozoso estarás./"
        },
        {
            "id": "1481",
            "chorusPos": [],
            "paragraph": " /Alertas estemos pues Cristo ya viene./                   /A llevar a los suyos a su santo hogar./"
        },
        {
            "id": "1482",
            "chorusPos": [],
            "paragraph": " /Allá en el cielo ¡gran gozo! tendremos./                     /En las mansiones de oro que nos espera./"
        }
    ]
}