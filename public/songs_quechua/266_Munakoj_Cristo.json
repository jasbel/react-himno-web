    "paragraphs": [
        {
            "id": "2811",
            "chorusPos": [],
            "paragraph": " /Munakoj Cristo, sonqoykita \n Pay wajyashan/"
        },
        {
            "id": "2812",
            "chorusPos": [],
            "paragraph": " /Qan, amigo, kicharillay arí. \n Sonqoykita Pay wajyashan . /"
        },
        {
            "id": "2813",
            "chorusPos": [],
            "paragraph": " /Maná uyarinki? Sonqoykita \n Pay wajyashan/"
        },
        {
            "id": "2814",
            "chorusPos": [],
            "paragraph": " /Qan, amigo, kicharillay arí. \n Sonqoykita Pay wajyashan . /"
        },
        {
            "id": "2815",
            "chorusPos": [],
            "paragraph": " /Uyarillayña, sonqoykita \n Pay wajyashan./"
        },
        {
            "id": "2816",
            "chorusPos": [],
            "paragraph": " /Qan, amigo, kicharillay arí. \n Sonqoykita Pay wajyashan . /"
        },
        {
            "id": "2817",
            "chorusPos": [],
            "paragraph": " /Cristo el Amado, \n llamando está a la puerta./"
        },
        {
            "id": "2818",
            "chorusPos": [],
            "paragraph": " /Oh amigo ¿por qué no le abres? \n Jesús está a la puerta./"
        },
        {
            "id": "2819",
            "chorusPos": [],
            "paragraph": " /¿Tu no lo oyes? \n Jesús está a la puerta./"
        },
        {
            "id": "2820",
            "chorusPos": [],
            "paragraph": " /Oh amigo ¿por qué no le abres? \n Jesús está a la puerta./"
        },
        {
            "id": "2821",
            "chorusPos": [],
            "paragraph": " /Responde pronto, \n Jesús está a la puerta./"
        },
        {
            "id": "2822",
