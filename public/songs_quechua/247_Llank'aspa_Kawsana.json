{
    "id": "247",
    "code": "247",
    "title": " 247   Llank'aspa Kawsana",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2689",
            "chorusPos": [],
            "paragraph": " /Llank'aspa kawsana, Diosllataña sirvispa. Juchapi kawsaspa, wañuyllaman risunchej./"
        },
        {
            "id": "2690",
            "chorusPos": [],
            "paragraph": " /Mosoj kawsay tukuypajmin \n Crístollapi tarikun/"
        },
        {
            "id": "2691",
            "chorusPos": [],
            "paragraph": " /Kay p'unchaykunapi llakiykunalla tiyan. Qolqellapi kashan runaspaía sonqonqa./"
        },
        {
            "id": "2692",
            "chorusPos": [],
            "paragraph": " /Mosoj kawsay tukuypajmin \n Crístollapi tarikun/"
        },
        {
            "id": "2693",
            "chorusPos": [],
            "paragraph": " /Chayrayku, hermanóy, t'aqay sonqoykitaqa Mundo kusiymanta, qolqe munaymantapis./"
        },
        {
            "id": "2694",
            "chorusPos": [],
            "paragraph": " /Mosoj kawsay tukuypajmin \n Crístollapi tarikun/"
        },
        {
            "id": "2695",
            "chorusPos": [],
            "paragraph": " /Somos siervos de Dios trabajemos para El. \n Si cedemos al mal nos espera el dolor./"
        },
        {
            "id": "2696",
            "chorusPos": [],
            "paragraph": " ¡NUEVA VIDA sólo en Cristo \n Hallaremos. Gloria a Dios./"
        },
        {
            "id": "2697",
            "chorusPos": [],
            "paragraph": " /Aquí en este mundo, lleno está de la maldad. \n Del dinero en pos, mucha gente hoy se va./"
        },
        {
            "id": "2698",
            "chorusPos": [],
            "paragraph": " ¡NUEVA VIDA sólo en Cristo"
        },
        {
            "id": "2699",
            "chorusPos": [],
            "paragraph": " /No vayamos jamás detrás de lo terrenal. \n Vamos a pregonar de Jesús, y de su amor./"
        },
        {
            "id": "2700",
            "chorusPos": [],
            "paragraph": " ¡NUEVA VIDA sólo en Cristo"
        }
    ]
}