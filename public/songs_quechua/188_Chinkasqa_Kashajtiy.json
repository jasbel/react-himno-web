{
    "id": "188",
    "code": "188",
    "title": " Chinkasqa Kashajtiy   188",
    "musicalNote": " (Do Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2105",
            "chorusPos": [],
            "paragraph": " /Chinkasqa kashajtiy, Jesús wajyawarqa/ /Tarinawampajtaj cruzkama chayarqa/"
        },
        {
            "id": "2106",
            "chorusPos": [],
            "paragraph": " /Chay munakuyninta yuyarikuspataj/                        /Ni jayk'aj qhepaman kutiriymanñachu./"
        },
        {
            "id": "2107",
            "chorusPos": [],
            "paragraph": " /K'ayachus, minchhachus Jesús wajyawanqa./ /Llank'asqaymantataj t'inkata qowanqa/"
        },
        {
            "id": "2108",
            "chorusPos": [],
            "paragraph": " /Janaj pachapitaj salvos kajkunawan/                 /Diospa ñawpaqempi may kusiypi kasaj/"
        },
        {
            "id": "2109",
            "chorusPos": [],
            "paragraph": " /Cuando yo vagaba, Jesús me ha llamado./ \n /Derramó su sangre para rescatarme./"
        },
        {
            "id": "2110",
            "chorusPos": [],
            "paragraph": " /Cuando yo medito en su amor tan grande./               /Jamás yo quisiera de Cristo alejarme./"
        },
        {
            "id": "2111",
            "chorusPos": [],
            "paragraph": " /Sí en cualquier momento Jesús me llamara,/                    /Él me ha prometido, recompensa darme./"
        },
        {
            "id": "2112",
            "chorusPos": [],
            "paragraph": " /Allá en el cielo con todos los salvos/                         /De la vida eterna gozaré por siempre./"
        }
    ]
}