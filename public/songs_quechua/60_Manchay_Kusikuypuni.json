    "title": " 60  Manchay Kusikuypuni",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "602",
            "chorusPos": [],
            "paragraph": " /Manchay kusikuypuni noqapaj ari, Tatáy, Belenpi nacesqayki./"
        },
        {
            "id": "603",
            "chorusPos": [],
            "paragraph": " /Noqaraykumin Qan, Tatáy, \n Cruzpi yawarta jicharqanki/"
        },
        {
            "id": "604",
            "chorusPos": [],
            "paragraph": " /Manchay kusikuypuni noqapaj ari, Tatáy, Ujtawan jamunayki/"
        },
        {
            "id": "605",
            "chorusPos": [],
            "paragraph": " /Noqaraykumin Qan, Tatáy, \n Cruzpi yawarta jicharqanki/"
        },
        {
            "id": "606",
            "chorusPos": [],
            "paragraph": " /Manchay kusikuypuni noqapaj ari, Tatáy, Qanwan wiñaypaj kanay./"
        },
        {
            "id": "607",
            "chorusPos": [],
            "paragraph": " /Noqaraykumin Qan, Tatáy, \n Cruzpi yawarta jicharqanki/"
        },
        {
            "id": "608",
            "chorusPos": [],
            "paragraph": " /Manchay kusikuypuni cielopi kanqa, \n Tatáy, Ñawpaqeykipi kanay./"
        },
        {
            "id": "609",
            "chorusPos": [],
            "paragraph": " /Noqaraykumin Qan, Tatáy, \n Cruzpi yawarta jicharqanki/"
        },
        {
            "id": "610",
            "chorusPos": [],
            "paragraph": " /Grande gozo yo siento en mi corazón, Oh Señor, \n Tú naciste en Belén./"
        },
        {
            "id": "611",
            "chorusPos": [],
            "paragraph": " /Por mis maldades, Oh Señor, \n Diste tu vida en la cruenta cruz/"
        },
        {
            "id": "612",
            "chorusPos": [],
            "paragraph": " /Grande gozo yo siento en mi corazón, Oh Señor, \n Por siempre viviré./"
        },
        {
            "id": "613",
            "chorusPos": [],
            "paragraph": " /Por mis maldades, Oh Señor, \n Diste tu vida en la cruenta cruz/"
        },
        {
            "id": "614",
            "chorusPos": [],
            "paragraph": " /Grande gozo yo siento en mi corazón, Oh Señor, \n Uno somos en Tí./"
        },
        {
            "id": "615",
            "chorusPos": [],
            "paragraph": " /Por mis maldades, Oh Señor, \n Diste tu vida en la cruenta cruz/"
        },
        {
            "id": "616",
            "chorusPos": [],
            "paragraph": " /Grande gozo allí tendré cuando vengas tu, Oh Señor, Junto a Tí yo estaré./"
        },
        {
            "id": "617",
            "chorusPos": [],
            "paragraph": " /Por mis maldades, Oh Señor, \n Diste tu vida en la cruenta cruz/"
        }
