{
    "id": "219",
    "code": "219",
    "title": " 219  Hermanos Takinachej",
    "musicalNote": " (Si Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2444",
            "chorusPos": [],
            "paragraph": " /Hermanos, takinachej Diosninchejman         Kay p'unchaypi sumaj kusiywan./"
        },
        {
            "id": "2445",
            "chorusPos": [],
            "paragraph": " /Señor Jesuswanña kaspa \n Tukuyninchej yupaychana ./"
        },
        {
            "id": "2446",
            "chorusPos": [],
            "paragraph": " /Hermanos, tukuyninchej kusikuywan Yupaychana Señorninchejta./"
        },
        {
            "id": "2447",
            "chorusPos": [],
            "paragraph": " /Señor Jesuswanña kaspa \n Tukuyninchej yupaychana ./"
        },
        {
            "id": "2448",
            "chorusPos": [],
            "paragraph": " /Hermanos, Dios Tataman gloria kachun       Kay p'unchaypi wiñaynintimpaj./"
        },
        {
            "id": "2449",
            "chorusPos": [],
            "paragraph": " /Señor Jesuswanña kaspa \n Tukuyninchej yupaychana ./"
        },
        {
            "id": "2450",
            "chorusPos": [],
            "paragraph": " /Hermanos, cantaremos a nuestro Dios, \n Alabando por su grande amor./"
        },
        {
            "id": "2451",
            "chorusPos": [],
            "paragraph": " /Los que somos del Señor \n A su nombre cantaremos./"
        },
        {
            "id": "2452",
            "chorusPos": [],
            "paragraph": " /Hermanos, honra y gloria sea a Jesús, \n Para siempre, por la eternidad./"
        },
        {
            "id": "2453",
            "chorusPos": [],
            "paragraph": " /Los que somos del Señor \n A su nombre cantaremos./"
        },
        {
            "id": "2454",
            "chorusPos": [],
            "paragraph": " /Hermanos, cantaremos a nuestro Dios \n Para siempre por su gran bondad./"
        },
        {
            "id": "2455",
            "chorusPos": [],
            "paragraph": " /Los que somos del Señor \n A su nombre cantaremos./"
        }
    ]
}