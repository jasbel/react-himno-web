{
    "id": "82",
    "code": "82",
    "title": " 82  Evangeliota Qhatisajpuni",
    "musicalNote": " (Do Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "832",
            "chorusPos": [],
            "paragraph": " //Evangeliota qhatisajpuni  // \n /Ni qhepaman kutiymanchu./"
        },
        {
            "id": "833",
            "chorusPos": [],
            "paragraph": " //Jucha saqespa, qhatisajpuni.// \n //Ni qhepaman kutiymanchu.//"
        },
        {
            "id": "834",
            "chorusPos": [],
            "paragraph": " //Runas rimajtin, qhatisajpuni.// \n //Ni qhepaman kutiymanchu./"
        },
        {
            "id": "835",
            "chorusPos": [],
            "paragraph": " //He decidido seguir a Cristo.// \n /No vuelvo atrás; no vuelvo atrás./"
        },
        {
            "id": "836",
            "chorusPos": [],
            "paragraph": " //El Rey de Gloria me ha transformado.// \n /No vuelvo atrás; no vuelvo atrás./"
        },
        {
            "id": "837",
            "chorusPos": [],
            "paragraph": " //En mis tristezas me da consuelo.// \n /No vuelvo atrás; no vuelvo atrás./"
        },
        {
            "id": "838",
            "chorusPos": [],
            "paragraph": " //La cruz delante, el mundo atrás.// \n /No vuelvo atrás; no vuelvo atrás./ \n La vida vieja"
        }
    ]
}