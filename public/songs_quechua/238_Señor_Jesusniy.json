{
    "id": "238",
    "code": "238",
    "title": " 238 Señor Jesusniy",
    "musicalNote": " (Re Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2597",
            "chorusPos": [],
            "paragraph": " Señor Jesusniy munakuyniyoj. \n Cruzpi wañuspa salvawarqa."
        },
        {
            "id": "2598",
            "chorusPos": [],
            "paragraph": " /Chayrayku takishani: &quot;Munakuwan&rdquo; \n Señor Jesusniy, Salvawajniy ./"
        },
        {
            "id": "2599",
            "chorusPos": [],
            "paragraph": " Juchaj kamachin noqa kashajtiy,                   Señor Jesuslla salvawarqa."
        },
        {
            "id": "2600",
            "chorusPos": [],
            "paragraph": " /Chayrayku takishani: &quot;Munakuwan&rdquo; \n Señor Jesusniy, Salvawajniy ./"
        },
        {
            "id": "2601",
            "chorusPos": [],
            "paragraph": " Nina larwayman rinay kashajtin,                    Señor Jesuslla salvawarqa."
        },
        {
            "id": "2602",
            "chorusPos": [],
            "paragraph": " /Chayrayku takishani: &quot;Munakuwan&rdquo; \n Señor Jesusniy, Salvawajniy ./"
        },
        {
            "id": "2603",
            "chorusPos": [],
            "paragraph": " Kunan sirvisaj Señorllataña, \n Kawsayniytapis Payman qosaj."
        },
        {
            "id": "2604",
            "chorusPos": [],
            "paragraph": " /Chayrayku takishani: &quot;Munakuwan&rdquo; \n Señor Jesusniy, Salvawajniy ./"
        },
        {
            "id": "2605",
            "chorusPos": [],
            "paragraph": " Jesús me ama vino a salvarme; \n Jesús me ama, murió por mí."
        },
        {
            "id": "2606",
            "chorusPos": [],
            "paragraph": " /Por eso canto siempre: &ldquo;Él me ama&rdquo;, \n Jesús me ama, mi Salvador./"
        },
        {
            "id": "2607",
            "chorusPos": [],
            "paragraph": " Yo era preso del vil pecado, \n Yo era preso, mas me libro."
        },
        {
            "id": "2608",
            "chorusPos": [],
            "paragraph": " /Por eso canto siempre: &ldquo;Él me ama&rdquo;, \n Jesús me ama, mi Salvador./"
        },
        {
            "id": "2609",
            "chorusPos": [],
            "paragraph": " Lo que merezco es el castigo, \n Lo que merezco Jesús pagó."
        },
        {
            "id": "2610",
            "chorusPos": [],
            "paragraph": " /Por eso canto siempre: &ldquo;Él me ama&rdquo;, \n Jesús me ama, mi Salvador./"
        },
        {
            "id": "2611",
            "chorusPos": [],
            "paragraph": " Ahora entrego mi vida y alma, \n Ahora entrego todo al Señor."
        },
        {
            "id": "2612",
            "chorusPos": [],
            "paragraph": " /Por eso canto siempre: &ldquo;Él me ama&rdquo;, \n Jesús me ama, mi Salvador./"
        }
    ]
}