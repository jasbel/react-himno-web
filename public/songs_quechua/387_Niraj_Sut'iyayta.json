{
    "id": "387",
    "code": "387",
    "title": " 387 Niraj Sut'iyayta",
    "musicalNote": " (Re Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3722",
            "chorusPos": [],
            "paragraph": " /Niraj sut'iyayta mask'aj jamuyki.\nSapa p'unchaypi Qanta suyayki./"
        },
        {
            "id": "3723",
            "chorusPos": [],
            "paragraph": " /Pruebas jamojtimpis, qhatisqaykipuni.\nLlakiyniypi sonqochaway/"
        },
        {
            "id": "3724",
            "chorusPos": [],
            "paragraph": " /Ama sayk'unaypaj yanapariway,\nÑannillaykita cheqán rinaypaj./"
        },
        {
            "id": "3725",
            "chorusPos": [],
            "paragraph": " /Pruebas jamojtimpis, qhatisqaykipuni.\nLlakiyniypi sonqochaway/"
        },
        {
            "id": "3726",
            "chorusPos": [],
            "paragraph": " /Muy de madrugada yo te buscaré,\nY todos los días yo te esperaré./"
        },
        {
            "id": "3727",
            "chorusPos": [],
            "paragraph": " /Aunque vengan pruebas, yo te seguiré.\nTú me darás consolación ./"
        },
        {
            "id": "3728",
            "chorusPos": [],
            "paragraph": " /Ayúdame, Señor, a perseverar\nEn tu camino, para serte fiel./"
        },
        {
            "id": "3729",
            "chorusPos": [],
            "paragraph": " /Aunque vengan pruebas, yo te seguiré.\nTú me darás consolación ./"
        }
    ]
}