{
    "id": "333",
    "code": "333",
    "title": " Cristo Kutimonqa Yuraj   333",
    "musicalNote": " (Fa Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3229",
            "chorusPos": [],
            "paragraph": " /Cristo kutimonqa yuraj phuyuspi,\nJatun atiyninwan pusawasunchej./"
        },
        {
            "id": "3230",
            "chorusPos": [],
            "paragraph": " /Jamushanña Jesusqa./\n/Pusariwasun./"
        },
        {
            "id": "3231",
            "chorusPos": [],
            "paragraph": " /Hermanos, orana may lugar pipis,\nDiospa bendicionnin jamuwasunchej/"
        },
        {
            "id": "3232",
            "chorusPos": [],
            "paragraph": " /Jamushanña Jesusqa./\n/Pusariwasun./"
        },
        {
            "id": "3233",
            "chorusPos": [],
            "paragraph": " /Cielomantapacha rikhurimonqa,\nJanaj pachamantaj pusariwasun/"
        },
        {
            "id": "3234",
            "chorusPos": [],
            "paragraph": " /Jamushanña Jesusqa./\n/Pusariwasun./"
        },
        {
            "id": "3235",
            "chorusPos": [],
            "paragraph": " /En la nube blanca Cristo volverá.\nCon poder y gloria Él nos llevará./"
        },
        {
            "id": "3236",
            "chorusPos": [],
            "paragraph": " /Cristo viene otra vez.\nÉl nos llevará./"
        },
        {
            "id": "3237",
            "chorusPos": [],
            "paragraph": " /Oremos hermanos en todo lugar,\nY recibiremos el don celestial./"
        },
        {
            "id": "3238",
            "chorusPos": [],
            "paragraph": " /Cristo viene otra vez.\nÉl nos llevará./"
        },
        {
            "id": "3239",
            "chorusPos": [],
            "paragraph": " /En el firmamento aparecerá,\nAl cielo infinito, Él nos llevará./"
        },
        {
            "id": "3240",
            "chorusPos": [],
            "paragraph": " /Cristo viene otra vez.\nÉl nos llevará./"
        }
    ]
}