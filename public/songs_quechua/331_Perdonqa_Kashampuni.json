{
    "id": "331",
    "code": "331",
    "title": " 331    Perdonqa Kashampuni",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3213",
            "chorusPos": [],
            "paragraph": " /Perdonqa kashampuni Cristoj yawarninnejta.\nPerdonqa kashampuni cruzpi wañusqanwan/"
        },
        {
            "id": "3214",
            "chorusPos": [],
            "paragraph": " /Takinachejyupaychaspa tukuy sonqonchejwan,\nSuyanachej jamuyninta, Salvadorninchejta./"
        },
        {
            "id": "3215",
            "chorusPos": [],
            "paragraph": " /Yupaychana tukuyninchej Señor Jesusninchejta.\n/Yupaychana tukuyninchej Salvawajninchejta./"
        },
        {
            "id": "3216",
            "chorusPos": [],
            "paragraph": " /Takinachejyupaychaspa tukuy sonqonchejwan,\nSuyanachej jamuyninta, Salvadorninchejta./"
        },
        {
            "id": "3217",
            "chorusPos": [],
            "paragraph": " /Tukuyman willamuna juchayoj kasqankuta,\nTukuyman willamuna chay perdonninmanta./"
        },
        {
            "id": "3218",
            "chorusPos": [],
            "paragraph": " /Takinachejyupaychaspa tukuy sonqonchejwan,\nSuyanachej jamuyninta, Salvadorninchejta./"
        },
        {
            "id": "3219",
            "chorusPos": [],
            "paragraph": " /Hay perdón por la sangre de nuestro Señor Jesús.\nHay perdón por su muerte de nuestro Salvador./"
        },
        {
            "id": "3220",
            "chorusPos": [],
            "paragraph": " /Cantaremos, alabando con todo el corazón,\nEsperemos el regreso de nuestro Salvador./"
        },
        {
            "id": "3221",
            "chorusPos": [],
            "paragraph": " /Alabemos todos juntos a nuestro Señor Jesús.\nAlabemos todos juntos a nuestro Salvador./"
        },
        {
            "id": "3222",
            "chorusPos": [],
            "paragraph": " /Cantaremos, alabando con todo el corazón,\nEsperemos el regreso de nuestro Salvador./"
        },
        {
            "id": "3223",
            "chorusPos": [],
            "paragraph": " /Anunciemos a la gente que carece del perdón./\n/Anunciemos a la gente del amor de Jesús./"
        },
        {
            "id": "3224",
            "chorusPos": [],
            "paragraph": " /Cantaremos, alabando con todo el corazón,\nEsperemos el regreso de nuestro Salvador./"
        }
    ]
}