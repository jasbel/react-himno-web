{
    "id": "385",
    "code": "385",
    "title": " 385        Llakiyniykipi",
    "musicalNote": " (Do Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3700",
            "chorusPos": [],
            "paragraph": " /Llakiyniykipi takiy Diosllaman./\n/Kusikuspa takejtiyki, llakiy riponqa./"
        },
        {
            "id": "3701",
            "chorusPos": [],
            "paragraph": " /Takishankichu, orashankichu?/\n/Creespalla mañajtiyki, kusiy tarinki./"
        },
        {
            "id": "3702",
            "chorusPos": [],
            "paragraph": " /Nak'ariypipis oray sonqowan./\n/Oraspalla kanki chayqa, llakiy riponqa./"
        },
        {
            "id": "3703",
            "chorusPos": [],
            "paragraph": " /Takishankichu, orashankichu?/\n/Creespalla mañajtiyki, kusiy tarinki./"
        },
        {
            "id": "3704",
            "chorusPos": [],
            "paragraph": " /Jesusman chimpay, yanapasonqa./\n/Pruebaspipis kashajtiyki, sonqochasonqa./"
        },
        {
            "id": "3705",
            "chorusPos": [],
            "paragraph": " /Takishankichu, orashankichu?/\n/Creespalla mañajtiyki, kusiy tarinki./"
        },
        {
            "id": "3706",
            "chorusPos": [],
            "paragraph": " /Canta en tu aflicción con el corazón./\n/Porque si cantando vas, alejas tu aflicción./"
        },
        {
            "id": "3707",
            "chorusPos": [],
            "paragraph": " /Si cantando vas, y si orando estás,/\n/Si tu oras con toda fe, todo cambiará./"
        },
        {
            "id": "3708",
            "chorusPos": [],
            "paragraph": " /Ora en tu aflicción, con el corazón./\n/Porque si tú orando vas, alejas tu aflicción./"
        },
        {
            "id": "3709",
            "chorusPos": [],
            "paragraph": " /Si cantando vas, y si orando estás,/\n/Si tu oras con toda fe, todo cambiará./"
        },
        {
            "id": "3710",
            "chorusPos": [],
            "paragraph": " /Confía en Jesús, El te ayudará./ \n /En momentos de tristeza, te consolará./"
        },
        {
            "id": "3711",
            "chorusPos": [],
            "paragraph": " /Si cantando vas, y si orando estás,/\n/Si tu oras con toda fe, todo cambiará./"
        }
    ]
}