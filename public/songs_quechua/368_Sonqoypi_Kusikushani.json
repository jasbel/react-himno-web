{
    "id": "368",
    "code": "368",
    "title": " 368 Sonqoypi Kusikushani",
    "musicalNote": " (Sol Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3516",
            "chorusPos": [],
            "paragraph": " //Sonqoypi kusikushani//\nSeñorniy wan."
        },
        {
            "id": "3517",
            "chorusPos": [],
            "paragraph": " //Gloria Diosman, aleluya//\nWiñaypajmin."
        },
        {
            "id": "3518",
            "chorusPos": [],
            "paragraph": " //Jesucristo jamonqaña//\nPusariwaj."
        },
        {
            "id": "3519",
            "chorusPos": [],
            "paragraph": " //Ruwasqaymanta qowanqa//\nT'inkasniyta."
        },
        {
            "id": "3520",
            "chorusPos": [],
            "paragraph": " //Tengo gozo en mi alma//\nCon mi Jesús."
        },
        {
            "id": "3521",
            "chorusPos": [],
            "paragraph": " //Gloria a Dios, aleluya.//\nPara siempre."
        },
        {
            "id": "3522",
            "chorusPos": [],
            "paragraph": " //Jesucristo pronto viene//\nA llevarme."
        },
        {
            "id": "3523",
            "chorusPos": [],
            "paragraph": " //Él me dará recompensa//\nEn el cielo."
        }
    ]
}