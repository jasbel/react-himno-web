{
    "id": "367",
    "code": "367",
    "title": " 367  Juchasapa Kasqaymanta",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3504",
            "chorusPos": [],
            "paragraph": " /Juchasapa kasqaymanta llakisqa kani./\n/Tukuynejta salvacionta mask'ani./"
        },
        {
            "id": "3505",
            "chorusPos": [],
            "paragraph": " /Juchasniypa llasayninwan ñit'isqa kani./\n/Pantayniyta waqasqaywan musphani./"
        },
        {
            "id": "3506",
            "chorusPos": [],
            "paragraph": " /Ukhu pachaj larwayninta rikushaniña./\n/Wajcha almaypa ñak'ariynín manchani./"
        },
        {
            "id": "3507",
            "chorusPos": [],
            "paragraph": " /Samariyta mask'ashani. Maymantaj risaj?/\n/Jesucristoj ñanninnejta purisaj./"
        },
        {
            "id": "3508",
            "chorusPos": [],
            "paragraph": " /Jesucristo Diospa Churin, Qanman jamuni./\n/Juchasniywan q'epirisqa jamuyki/"
        },
        {
            "id": "3509",
            "chorusPos": [],
            "paragraph": " /Cruzpi ñak'arisqaykiwan almayta libray./\n/Yawarniykej ch'ajchuyninwan mayllaway./"
        },
        {
            "id": "3510",
            "chorusPos": [],
            "paragraph": " /El pesar de mi pecado, dolor me causa./\n/Por todas partes yo busco salvación./"
        },
        {
            "id": "3511",
            "chorusPos": [],
            "paragraph": " /Con el peso del pecado, soy oprimido./\n/El llanto por mis errores sufro yo./"
        },
        {
            "id": "3512",
            "chorusPos": [],
            "paragraph": " /El infierno ardoroso voy divisando./\n/El sufrir de mi pobre alma temo yo./"
        },
        {
            "id": "3513",
            "chorusPos": [],
            "paragraph": " /El alivio voy buscando ¿a dónde fuera?/\n/Por la senda de mi Cristo andaré./"
        },
        {
            "id": "3514",
            "chorusPos": [],
            "paragraph": " /Hijo de Dios, Jesucristo, a Ti me alieno./\n/Cargado de mis pecados, vengo a Ti./"
        },
        {
            "id": "3515",
            "chorusPos": [],
            "paragraph": " /Con tu muerte padecida, libera mi alma./\n/Con tu sangre derramada, lávame./"
        }
    ]
}