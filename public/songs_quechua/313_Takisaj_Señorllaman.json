    "code": "313",
    "title": " Takisaj Señorllaman     313",
    "musicalNote": " (Sol Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3038",
            "chorusPos": [],
            "paragraph": " /Takisaj Señorllaman kutimunankama,\nTakillasajpuni Señormanqa/"
        },
        {
            "id": "3039",
            "chorusPos": [],
            "paragraph": " /Wawasniykiman churamuy bendicionta \n kawsanaykupaj munanakuyllapi./"
        },
        {
            "id": "3040",
            "chorusPos": [],
            "paragraph": " /Willarasaj Diosmanta kutimunankama,\nWillarasajpuni Diosmantaqa./"
        },
        {
            "id": "3041",
            "chorusPos": [],
            "paragraph": " /Wawasniykiman churamuy bendicionta \n kawsanaykupaj munanakuyllapi./"
        },
        {
            "id": "3042",
            "chorusPos": [],
            "paragraph": " /Voy a seguir cantando hasta que venga el Rey.\nVoy a seguir cantando a mi Señor./"
        },
        {
            "id": "3043",
            "chorusPos": [],
            "paragraph": " /Tus manos, Señor, extiende a tu pueblo.\nTus manos, Señor, de amor y santidad./"
        },
        {
            "id": "3044",
            "chorusPos": [],
            "paragraph": " /Voy a seguir anunciando hasta que venga el Rey,\nVoy a seguir anunciando del Señor./"
        },
        {
            "id": "3045",
            "chorusPos": [],
            "paragraph": " /Tus manos, Señor, extiende a tu pueblo.\nTus manos, Señor, de amor y santidad./"
        }
    ]
}