    "title": " Kusikuni Sonqoy  312",
    "musicalNote": " (Sol Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3030",
            "chorusPos": [],
            "paragraph": " /Kusikuni sonqoy ukhupi,\nSalvawanña, nispa takiniy"
        },
        {
            "id": "3031",
            "chorusPos": [],
            "paragraph": " /Gloria, aleluya Salvadorman.\nPaywan risaj, nispa takini./"
        },
        {
            "id": "3032",
            "chorusPos": [],
            "paragraph": " /Cristollamin Salvawajneyqa, \n Willarasaj tukuy runasman./"
        },
        {
            "id": "3033",
            "chorusPos": [],
            "paragraph": " /Gloria, aleluya Salvadorman.\nPaywan risaj, nispa takini./"
        },
        {
            "id": "3034",
            "chorusPos": [],
            "paragraph": " /Contento estoy en mi corazón.\nDe Cristo soy, esta es mi canción./"
        },
        {
            "id": "3035",
            "chorusPos": [],
            "paragraph": " /Gloria, aleluya al Salvador.\nAl cielo voy, esta es mi canción./"
        },
        {
            "id": "3036",
            "chorusPos": [],
            "paragraph": " /En Cristo hay plena salvación.\nHablar de Él, esa es mi canción./"
        },
        {
            "id": "3037",
            "chorusPos": [],
            "paragraph": " /Gloria, aleluya al Salvador.\nAl cielo voy, esta es mi canción./"
        }
    ]
}