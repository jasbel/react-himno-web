{
    "id": "446",
    "code": "446",
    "title": " 446 Qhuyaj sonqo Mama",
    "musicalNote": " (Mi Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "4211",
            "chorusPos": [],
            "paragraph": " Qhuyaj sonqo /mamayku kanki\nDios qopusuchun kusikuyta/"
        },
        {
            "id": "4212",
            "chorusPos": [],
            "paragraph": " Dios yanapan; /tukuy mamasta\nLlamp'u sonqoyoj kanankupaj/"
        },
        {
            "id": "4213",
            "chorusPos": [],
            "paragraph": " Dios Tatanchej /sonqochasuchun\nLlakiyniykipi kay pachapi  /"
        },
        {
            "id": "4214",
            "chorusPos": [],
            "paragraph": " Dios Tatanchej /qopusuchuntaj/\nKusiy kawsay ta kay pachapi./"
        },
        {
            "id": "4215",
            "chorusPos": [],
            "paragraph": " Madre, madre /Dios te bendiga/\nTe deseamos de corazón."
        },
        {
            "id": "4216",
            "chorusPos": [],
            "paragraph": " Madre, madre /madre paciente\nTú eres tierna de corazón./"
        },
        {
            "id": "4217",
            "chorusPos": [],
            "paragraph": " Madre, madre /Madre estimada\nDios te consuele en tu sufrir./"
        },
        {
            "id": "4218",
            "chorusPos": [],
            "paragraph": " Madre, madre /Madre prudente\nDios te conceda vida feliz./"
        }
    ]
}