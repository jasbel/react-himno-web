{
    "id": "52",
    "code": "52",
    "title": " 52   Cristollaman Qoni",
    "musicalNote": " (Re Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "498",
            "chorusPos": [],
            "paragraph": " /Cristollaman qoni tukuy kawsayniyta. \n Payllamin noqata salvakuwarqa./"
        },
        {
            "id": "499",
            "chorusPos": [],
            "paragraph": " /Cristolla tiyakun Sonqoy ukhupeqa \n Wiñay wiñaypaj./"
        },
        {
            "id": "500",
            "chorusPos": [],
            "paragraph": " /Yupaychana Diosta kutimunankama; Pusakapuwasun mosoj llajtanman./"
        },
        {
            "id": "501",
            "chorusPos": [],
            "paragraph": " /Cristolla tiyakun Sonqoy ukhupeqa \n Wiñay wiñaypaj./"
        },
        {
            "id": "502",
            "chorusPos": [],
            "paragraph": " /Diosta qhesachajqa wañuyllaman renqa. Jesusllapi tiyan jatun salvación/"
        },
        {
            "id": "503",
            "chorusPos": [],
            "paragraph": " /Cristolla tiyakun Sonqoy ukhupeqa \n Wiñay wiñaypaj./"
        },
        {
            "id": "504",
            "chorusPos": [],
            "paragraph": " /Tukuy bendiciompis Jesusmanta jamun. Tukuynin wawasnin yupaychanachej./"
        },
        {
            "id": "505",
            "chorusPos": [],
            "paragraph": " /Cristolla tiyakun Sonqoy ukhupeqa \n Wiñay wiñaypaj./"
        },
        {
            "id": "506",
            "chorusPos": [],
            "paragraph": " /A Jesús entrego mi vida entera, \n Porque sólo Cristo me dio salvación./"
        },
        {
            "id": "507",
            "chorusPos": [],
            "paragraph": " /Sólo Cristo podrá en mi vida morar \n Por la eternidad./"
        },
        {
            "id": "508",
            "chorusPos": [],
            "paragraph": " /A Cristo alabemos hasta que Él vuelva,                   Pronto gozaremos en su santo hogar./"
        },
        {
            "id": "509",
            "chorusPos": [],
            "paragraph": " /Sólo Cristo podrá en mi vida morar \n Por la eternidad./"
        },
        {
            "id": "510",
            "chorusPos": [],
            "paragraph": " /El que rechazare a Jesús bendito, \n A la muerte eterna se condenará./"
        },
        {
            "id": "511",
            "chorusPos": [],
            "paragraph": " /Sólo Cristo podrá en mi vida morar \n Por la eternidad./"
        },
        {
            "id": "512",
            "chorusPos": [],
            "paragraph": " /En su amor tan grande Jesús nos bendijo,             Alabemos siempre todos al Señor./"
        },
        {
            "id": "513",
            "chorusPos": [],
            "paragraph": " /Sólo Cristo podrá en mi vida morar \n Por la eternidad./"
        }
    ]
}