    "code": "470",
    "title": " Señorniy wajyashawanki  470",
    "musicalNote": " (Sol Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "4441",
            "chorusPos": [],
            "paragraph": " //Señorniy wajyashawanki://\nCruzniywan Qanta qhatinaypaj."
        },
        {
            "id": "4442",
            "chorusPos": [],
            "paragraph": " //Mayllamampis Qanwan risaj//\nQantallata noqa qhatisqayki."
        },
        {
            "id": "4443",
            "chorusPos": [],
            "paragraph": " //Ñak'ariypis jamuwajtin.//\nQanrayku ñak'arisaj Jesús."
        },
        {
            "id": "4444",
            "chorusPos": [],
            "paragraph": " //Mayllamampis Qanwan risaj//\nQantallata noqa qhatisqayki."
        },
        {
            "id": "4445",
            "chorusPos": [],
            "paragraph": " //Wañuykama ñak'arisaj//\nQanrayku Señor wañusajpis"
        },
        {
            "id": "4446",
            "chorusPos": [],
            "paragraph": " //Mayllamampis Qanwan risaj//\nQantallata noqa qhatisqayki."
        },
        {
            "id": "4447",
            "chorusPos": [],
            "paragraph": " //Wiñaypaj kusikamusaj//\nGloriaykipi Qanwan Jesusniy."
        },
        {
            "id": "4448",
            "chorusPos": [],
            "paragraph": " //Mayllamampis Qanwan risaj//\nQantallata noqa qhatisqayki."
        },
        {
            "id": "4449",
            "chorusPos": [],
            "paragraph": " //Puedo oir tu voz llamando//\nCon tu cruz hoy ven en pos de mí."
        },
        {
            "id": "4450",
            "chorusPos": [],
            "paragraph": " //Seguiré do Tú me guíes.//\nDondequiera fiel te seguiré."
        },
        {
            "id": "4451",
            "chorusPos": [],
            "paragraph": " //Yo te seguiré en el huerto//\nSufriré contigo, mi Jesús."
        },
        {
            "id": "4452",
            "chorusPos": [],
            "paragraph": " //Seguiré do Tú me guíes.//\nDondequiera fiel te seguiré."
        },
        {
            "id": "4453",
            "chorusPos": [],
            "paragraph": " //Me darás la gracia y gloria//\nY por siempre Tú me guiarás."
        },
        {
            "id": "4454",
            "chorusPos": [],
            "paragraph": " //Seguiré do Tú me guíes.//\nDondequiera fiel te seguiré."
        }
    ]
}