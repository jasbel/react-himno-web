{
    "id": "285",
    "code": "285",
    "title": " 285 Wasiy Tiyan",
    "musicalNote": " (Sol Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "0",
            "chorusPos": [],
            "paragraph": " //Wasiy tiyan intimanta aswanta k'anchaj.//\nJanaj pachapi."
        },
        {
            "id": "2893",
            "chorusPos": [],
            "paragraph": " //Bendito Cristo, Qanwan  kawsamusaj.//\n Janaj pachapi."
        },
        {
            "id": "2894",
            "chorusPos": [],
            "paragraph": " //Qan munanki riyta chayqa, usqayta jamuy//\nSeñor Jesusman."
        },
        {
            "id": "2895",
            "chorusPos": [],
            "paragraph": " //Un palacio tengo allá más lindo que el sol.//\nEn el más allá."
        },
        {
            "id": "2896",
            "chorusPos": [],
            "paragraph": " //Bendito Cristo contigo yo estaré.//\nEn el más allá."
        },
        {
            "id": "2897",
            "chorusPos": [],
            "paragraph": " //Si tu quieres ir al cielo ven al Señor.//\nVen sin demorar."
        }
    ]
}