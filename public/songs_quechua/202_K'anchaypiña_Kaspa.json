{
    "id": "202",
    "code": "202",
    "title": " K'anchaypiña Kaspa     202",
    "musicalNote": " (Do Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2232",
            "chorusPos": [],
            "paragraph": " /K'anchaypiña kaspa, allinta qan puriy, Diosninchej rikumun./"
        },
        {
            "id": "2233",
            "chorusPos": [],
            "paragraph": " /Allinta qan puriy \n Diosninchej qhawamushasunki/"
        },
        {
            "id": "2234",
            "chorusPos": [],
            "paragraph": " /Diosninchej qhawamun tukuy kay pachata, Allinta qan puriy./"
        },
        {
            "id": "2235",
            "chorusPos": [],
            "paragraph": " /Allinta qan puriy \n Diosninchej qhawamushasunki/"
        },
        {
            "id": "2236",
            "chorusPos": [],
            "paragraph": " /Señorllata qhaway, kasuy nisqasninta. \n Atipay sajrata/"
        },
        {
            "id": "2237",
            "chorusPos": [],
            "paragraph": " /Allinta qan puriy \n Diosninchej qhawamushasunki/"
        },
        {
            "id": "2238",
            "chorusPos": [],
            "paragraph": " /Cada paso que das por la senda de luz, \n Hay un Dios que te ve./"
        },
        {
            "id": "2239",
            "chorusPos": [],
            "paragraph": " /Dios te ve, Dios te ve. \n Mira bien el camino que vas./"
        },
        {
            "id": "2240",
            "chorusPos": [],
            "paragraph": " /Los ojos del Señor sobre el mundo están, \n Que los ve a todos./"
        },
        {
            "id": "2241",
            "chorusPos": [],
            "paragraph": " /Dios te ve, Dios te ve. \n Mira bien el camino que vas./"
        },
        {
            "id": "2242",
            "chorusPos": [],
            "paragraph": " /Mira pues al Señor cumpliendo tu deber, \n Vence el mal con el bien./"
        },
        {
            "id": "2243",
            "chorusPos": [],
            "paragraph": " /Dios te ve, Dios te ve. \n Mira bien el camino que vas./"
        }
    ]
}