{
    "id": "349",
    "code": "349",
    "title": " Qayllaykamuy Cristoman 349",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3376",
            "chorusPos": [],
            "paragraph": " /Qayllaykamuy Cristoman/\n/Tuta p'unchay pusasonqa.\nQayllaykamuy Cristoman /"
        },
        {
            "id": "3377",
            "chorusPos": [],
            "paragraph": " /Ripusunchej Cristowan y\n/Wiñay wiñaypaj kawsakoj.\nRipusunchej Cristowan/"
        },
        {
            "id": "3378",
            "chorusPos": [],
            "paragraph": " /No te alejes de Cristo y\n/Día y noche te guiará.\nNo te alejes de Cristo./"
        },
        {
            "id": "3379",
            "chorusPos": [],
            "paragraph": " /Pronto iremos al cielo/\n/Día y noche te guiará.\nPronto iremos al cielo./"
        }
    ]
}