{
    "id": "195",
    "code": "195",
    "title": " 195 Dios Tatanchej",
    "musicalNote": " (Re Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2170",
            "chorusPos": [],
            "paragraph": " /Dios Tatanchej Churinta kachamun./ \n /Munakuywan kay mundota salvan/"
        },
        {
            "id": "2171",
            "chorusPos": [],
            "paragraph": " /Jesucristo perdonta qowanchej./ \n /Chimpaykuna tukuy juchanchejwan./"
        },
        {
            "id": "2172",
            "chorusPos": [],
            "paragraph": " /Dios Tatanchej tukuyta wajyashan/ /Salvanampaj nina larwaymanta  /"
        },
        {
            "id": "2173",
            "chorusPos": [],
            "paragraph": " /Kunampacha Jesusman qayllaykuy./ \n /Salvacionta ama qhesachaychu./"
        },
        {
            "id": "2174",
            "chorusPos": [],
            "paragraph": " /Dios  el Padre mandó a Jesucristo/ \n /Para darnos Salvación eterna./"
        },
        {
            "id": "2175",
            "chorusPos": [],
            "paragraph": " /Jesucristo su perdón  te ofrece./ \n /Sólo Hl puede limpiar tus pecados./"
        },
        {
            "id": "2176",
            "chorusPos": [],
            "paragraph": " /Dios el Padre a todos les llama,/ \n /Del infierno Él quiere salvarles./"
        },
        {
            "id": "2177",
            "chorusPos": [],
            "paragraph": " /Ahora mismo acéptale a Cristo./ \n /No rechaces salvación eterna./"
        }
    ]
}