{
    "id": "129",
    "code": "129",
    "title": " Diosníy Qanllapiña Confiani",
    "musicalNote": " (Mi Menor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "1407",
            "chorusPos": [],
            "paragraph": " /Diosníy, Qanllapiña noqa confiakuni \n Tukuy sonqoymanta./"
        },
        {
            "id": "1408",
            "chorusPos": [],
            "paragraph": " /Chayrayku, Dios Tatáy, perdonta \n mañaspa Chimpaykamuyki./"
        },
        {
            "id": "1409",
            "chorusPos": [],
            "paragraph": " /Diosníy, mañakuyki, perdonarillaway \n Tukuy juchaymanta/"
        },
        {
            "id": "1410",
            "chorusPos": [],
            "paragraph": " /Chayrayku, Dios Tatáy, perdonta \n mañaspa Chimpaykamuyki./"
        },
        {
            "id": "1411",
            "chorusPos": [],
            "paragraph": " /Diosníy, mañakuyki uj kusiy kawsayta \n Qan qonawaykita./"
        },
        {
            "id": "1412",
            "chorusPos": [],
            "paragraph": " /Chayrayku, Dios Tatáy, perdonta \n mañaspa Chimpaykamuyki./"
        },
        {
            "id": "1413",
            "chorusPos": [],
            "paragraph": " /Diosníy, yanapaway Qanta sirvikuyta \n Jamunaykikama/"
        },
        {
            "id": "1414",
            "chorusPos": [],
            "paragraph": " /Chayrayku, Dios Tatáy, perdonta \n mañaspa Chimpaykamuyki./"
        },
        {
            "id": "1415",
            "chorusPos": [],
            "paragraph": " /Oh Dios poderoso, En Ti yo confío \n Con toda mi alma./"
        },
        {
            "id": "1416",
            "chorusPos": [],
            "paragraph": " /Vengo a tu diestra, perdón te imploro, \n Dios amoroso./"
        },
        {
            "id": "1417",
            "chorusPos": [],
            "paragraph": " / Oh   Dios bondadoso ,  perdón te imploro \n Por todas mis culpas./"
        },
        {
            "id": "1418",
            "chorusPos": [],
            "paragraph": " /Vengo a tu diestra, perdón te imploro, \n Dios amoroso./"
        },
        {
            "id": "1419",
            "chorusPos": [],
            "paragraph": " / Oh   Dios, te   imploro me   des en tu gracia \n Paz, gozo en mi vida./"
        },
        {
            "id": "1420",
            "chorusPos": [],
            "paragraph": " /Vengo a tu diestra, perdón te imploro, \n Dios amoroso./"
        },
        {
            "id": "1421",
            "chorusPos": [],
            "paragraph": " / Oh Dios, ayúdame servirte fielmente \n Hasta tu venida./"
        },
        {
            "id": "1422",
            "chorusPos": [],
            "paragraph": " /Vengo a tu diestra, perdón te imploro, \n Dios amoroso./"
