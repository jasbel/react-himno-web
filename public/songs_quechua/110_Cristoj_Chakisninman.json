{
    "id": "110",
    "code": "110",
    "title": " 110  Cristoj Chakisninman",
    "musicalNote": " (Mi Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "1182",
            "chorusPos": [],
            "paragraph": " /Cristoj chakisninman chimpaykamusaj, Salvacionninmanta graciasta qospa/"
        },
        {
            "id": "1183",
            "chorusPos": [],
            "paragraph": " /Diosman takisaj yupaychayninta. \n Runasman willasaj salvacionmanta ./"
        },
        {
            "id": "1184",
            "chorusPos": [],
            "paragraph": " /Diosniypa chajrampi noqa llank'asaj \n Kay laqha mundopi kawsanaykama./"
        },
        {
            "id": "1185",
            "chorusPos": [],
            "paragraph": " /Diosman takisaj yupaychayninta. \n Runasman willasaj salvacionmanta ./"
        },
        {
            "id": "1186",
            "chorusPos": [],
            "paragraph": " /Espíritu Santo pusawasunchej \n Señorpa chajrampi llank'ajkunata./"
        },
        {
            "id": "1187",
            "chorusPos": [],
            "paragraph": " /Diosman takisaj yupaychayninta. \n Runasman willasaj salvacionmanta ./"
        },
        {
            "id": "1188",
            "chorusPos": [],
            "paragraph": " /A los pies de Cristo me inclinaré, \n Y daré las gracias por su redención./"
        },
        {
            "id": "1189",
            "chorusPos": [],
            "paragraph": " /Yo quiero cantar sus alabanzas, \n Y también, de Cristo yo proclamaré./"
        },
        {
            "id": "1190",
            "chorusPos": [],
            "paragraph": " /De Cristo en la viña yo trabajaré, \n Mientras mi existencia en la vida aquí./"
        },
        {
            "id": "1191",
            "chorusPos": [],
            "paragraph": " /Yo quiero cantar sus alabanzas, \n Y también, de Cristo yo proclamaré./"
        },
        {
            "id": "1192",
            "chorusPos": [],
            "paragraph": " /Espíritu Santo guiará a todos, \n A los que trabajan en su viña hoy./"
        },
        {
            "id": "1193",
            "chorusPos": [],
            "paragraph": " /Yo quiero cantar sus alabanzas, \n Y también, de Cristo yo proclamaré./"
        }
    ]
}