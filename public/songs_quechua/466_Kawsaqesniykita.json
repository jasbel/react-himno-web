{
    "id": "466",
    "code": "466",
    "title": " 466  Kawsaqesniykita",
    "musicalNote": " (Fa Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "4413",
            "chorusPos": [],
            "paragraph": " /Kawsaqesniykitachus qhuyanki chayqa,\nWillaray Jesús salvasusqanta/"
        },
        {
            "id": "4414",
            "chorusPos": [],
            "paragraph": " /Parlay Cristomanta; willay kawsaqesman,\nCristo qanrayku wañusqanta./"
        },
        {
            "id": "4415",
            "chorusPos": [],
            "paragraph": " /Willaramuy, willaramuy,\nMayllapipis willay Jesusmanta/"
        },
        {
            "id": "4416",
            "chorusPos": [],
            "paragraph": " /Si sientes compasión por tus amigos.\nEntonces habíales de tu Señor./"
        },
        {
            "id": "4417",
            "chorusPos": [],
            "paragraph": " /Habíales de Cristo; cuenta a tus amigos\nLo que el Salvador hizo por Tí./"
        },
        {
            "id": "4418",
            "chorusPos": [],
            "paragraph": " /Testifica, testifica, \n Testifica de Cristo por doquier./"
        }
    ]
}