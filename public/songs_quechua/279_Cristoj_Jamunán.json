{
    "id": "279",
    "code": "279",
    "title": " Cristoj Jamunán   279",
    "musicalNote": " (Do Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "2860",
            "chorusPos": [],
            "paragraph": " /Cristoj jamunán juntakushanña. \n Salvasqa almasta pusarenqa/"
        },
        {
            "id": "2861",
            "chorusPos": [],
            "paragraph": " /Pay wan risaj, risaj Pay wan./ \n Jesucristowan rísajpuni."
        },
        {
            "id": "2862",
            "chorusPos": [],
            "paragraph": " /Qhepakonqanku juchayojkuna, \n Salvasqastajrí riponqanku./"
        },
        {
            "id": "2863",
            "chorusPos": [],
            "paragraph": " /Pay wan risaj, risaj Pay wan./ \n Jesucristowan rísajpuni."
        },
        {
            "id": "2864",
            "chorusPos": [],
            "paragraph": " /Cristo ya viene, señales ya hay, \n Almas salvadas viene a llevar./"
        },
        {
            "id": "2865",
            "chorusPos": [],
            "paragraph": " /Yo voy con El, con Él yo voy./ \n Con Jesucristo pronto me iré."
        },
        {
            "id": "2866",
            "chorusPos": [],
            "paragraph": " /Los pecadores se quedarán. \n Y los salvados irán con Él./"
        },
        {
            "id": "2867",
            "chorusPos": [],
            "paragraph": " /Yo voy con El, con Él yo voy./ \n Con Jesucristo pronto me iré."
        }
    ]
}