{
    "id": "337",
    "code": "337",
    "title": " Kay Pacha Tukukonqaña 337",
    "musicalNote": " (La Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "3266",
            "chorusPos": [],
            "paragraph": " /Kay pachaqa tukukonqaña,\nRunastajri ñak'arenqanku/"
        },
        {
            "id": "3267",
            "chorusPos": [],
            "paragraph": " Aleluya, aleluya,\nGloria Señorniyman."
        },
        {
            "id": "3268",
            "chorusPos": [],
            "paragraph": " /Qayllapiña llakiy jamunan,\nQayllapiña Diospa jasut'in./"
        },
        {
            "id": "3269",
            "chorusPos": [],
            "paragraph": " Aleluya, aleluya,\nGloria Señorniyman."
        },
        {
            "id": "3270",
            "chorusPos": [],
            "paragraph": " /Manapuni qhepakusajchu,\nManapuni ñak'ariypajqa./"
        },
        {
            "id": "3271",
            "chorusPos": [],
            "paragraph": " Aleluya, aleluya,\nGloria Señorniyman."
        },
        {
            "id": "3272",
            "chorusPos": [],
            "paragraph": " /Este mundo ya se termina,\nEsta humanidad se afligirá./"
        },
        {
            "id": "3273",
            "chorusPos": [],
            "paragraph": " /Aleluya, aleluya,\nGloria a Tí Señor./"
        },
        {
            "id": "3274",
            "chorusPos": [],
            "paragraph": " /Ya se acerca las aflicciones,\nYa se acerca la fatalidad./"
        },
        {
            "id": "3275",
            "chorusPos": [],
            "paragraph": " /Aleluya, aleluya,\nGloria a Tí Señor./"
        },
        {
            "id": "3276",
            "chorusPos": [],
            "paragraph": " /No, no, no quiero quedarme aquí,\nNo, no, no quiero sufrir aquí./"
        },
        {
            "id": "3277",
            "chorusPos": [],
            "paragraph": " /Aleluya, aleluya,\nGloria a Tí Señor./"
        }
    ]
}