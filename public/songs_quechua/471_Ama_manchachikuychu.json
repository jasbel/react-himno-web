{
    "id": "471",
    "code": "471",
    "title": " 471   Ama manchachikuychu",
    "musicalNote": " (Sol Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "4455",
            "chorusPos": [],
            "paragraph": " /\"Ama manchachikuychu\" niwan Señor\n\"Atiyniyoj Diosniyki kani\"./"
        },
        {
            "id": "4456",
            "chorusPos": [],
            "paragraph": " /\"Mañakuway, noqa qosqayki;\nMosoj willáy yachachisqayki\"./"
        },
        {
            "id": "4457",
            "chorusPos": [],
            "paragraph": " /\"Kallpachakuy, chanta wapuchakuytaj qan\"/\n/Kamachisniyta ama saqespa./"
        },
        {
            "id": "4458",
            "chorusPos": [],
            "paragraph": " /\"Mañakuway, noqa qosqayki;\nMosoj willáy yachachisqayki\"./"
        },
        {
            "id": "4459",
            "chorusPos": [],
            "paragraph": " /\"No temas que yo estoy contigo,\nNo temas que yo soy Tu Dios\"./"
        },
        {
            "id": "4460",
            "chorusPos": [],
            "paragraph": " /\"Clama a mí y te responderé\nCosas nuevas te enseñaré\"./"
        },
        {
            "id": "4461",
            "chorusPos": [],
            "paragraph": " /\"Esfuérzate y sé muy valiente\",\nDe este libro no te apartes./"
        },
        {
            "id": "4462",
            "chorusPos": [],
            "paragraph": " /\"Clama a mí y te responderé\nCosas nuevas te enseñaré\"./"
        }
    ]
}