{
    "id": "471",
    "code": "471",
    "title": " 471   Ama manchachikuychu",
    "musicalNote": " (Sol Mayor)",
    "chorus": [],
    "paragraphs": [
        {
            "id": "4455",
            "chorusPos": [],
            "paragraph": " /&quot;Ama manchachikuychu&quot; niwan Señor\n&quot;Atiyniyoj Diosniyki kani&quot;./"
        },
        {
            "id": "4456",
            "chorusPos": [],
            "paragraph": " /&quot;Mañakuway, noqa qosqayki;\nMosoj willáy yachachisqayki&quot;./"
        },
        {
            "id": "4457",
            "chorusPos": [],
            "paragraph": " /&quot;Kallpachakuy, chanta wapuchakuytaj qan&quot;/\n/Kamachisniyta ama saqespa./"
        },
        {
            "id": "4458",
            "chorusPos": [],
            "paragraph": " /&quot;Mañakuway, noqa qosqayki;\nMosoj willáy yachachisqayki&quot;./"
        },
        {
            "id": "4459",
            "chorusPos": [],
            "paragraph": " /&quot;No temas que yo estoy contigo,\nNo temas que yo soy Tu Dios&quot;./"
        },
        {
            "id": "4460",
            "chorusPos": [],
            "paragraph": " /&quot;Clama a mí y te responderé\nCosas nuevas te enseñaré&quot;./"
        },
        {
            "id": "4461",
            "chorusPos": [],
            "paragraph": " /&quot;Esfuérzate y sé muy valiente&quot;,\nDe este libro no te apartes./"
        },
        {
            "id": "4462",
            "chorusPos": [],
            "paragraph": " /&quot;Clama a mí y te responderé\nCosas nuevas te enseñaré&quot;./"
        }
    ]
}